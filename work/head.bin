    <style>
        :root {
            --primary-red: #DC2626;
            --primary-red-dark: #991B1B;
            --primary-red-light: #EF4444;
            --bg-dark: #0A0A0A;
            --bg-card: #141414;
            --bg-card-hover: #1A1A1A;
            --text-white: #FFFFFF;
            --text-gray: #A3A3A3;
            --text-light-gray: #D4D4D4;
            --border-dark: #262626;
            --border-red: rgba(220, 38, 38, 0.3);
            --glow-red: rgba(220, 38, 38, 0.4);
            --shadow-dark: rgba(0, 0, 0, 0.5);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg-dark);
            background-image: 
                radial-gradient(ellipse at top, rgba(220, 38, 38, 0.08) 0%, transparent 50%),
                radial-gradient(ellipse at bottom right, rgba(220, 38, 38, 0.05) 0%, transparent 40%);
            color: var(--text-white);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            line-height: 1.6;
        }

        .container {
            width: 100%;
            max-width: 640px;
            background: var(--bg-card);
            border: 1px solid var(--border-dark);
            border-radius: 20px;
            box-shadow: 
                0 25px 50px -12px var(--shadow-dark),
                0 0 0 1px rgba(255, 255, 255, 0.03),
                inset 0 1px 0 rgba(255, 255, 255, 0.05);
            overflow: hidden;
            animation: fadeInUp 0.6s ease-out;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header-accent {
            height: 4px;
            background: linear-gradient(90deg, var(--primary-red-dark), var(--primary-red), var(--primary-red-light));
            box-shadow: 0 2px 20px var(--glow-red);
        }

        .content-wrapper {
            padding: 32px;
        }

        #count {
            text-align: center;
            padding: 40px 20px;
        }

        #count h4 {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text-white);
            margin-bottom: 20px;
        }

        #box {
            display: none;
        }
        
        .download-section {
            text-align: center;
        }

        .download-section h4 {
            font-size: 1rem;
            font-weight: 500;
            color: var(--text-light-gray);
            margin-bottom: 24px;
            line-height: 1.7;
        }

        .file-info-card {
            background: rgba(220, 38, 38, 0.05);
            border: 1px solid var(--border-red);
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 28px;
        }

        .file-info {
            font-size: 0.95rem;
            margin: 8px 0;
            color: var(--text-gray);
            text-align: left;
        }

        .file-info span {
            color: var(--text-white);
            font-weight: 600;
            word-break: break-word;
            display: block;
            margin-top: 4px;
        }

        #dl-links-wrapper {
            position: relative;
            margin-top: 20px;
        }

        #countdown-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: rgba(10, 10, 10, 0.85);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border-radius: 16px;
            border: 1px solid var(--border-dark);
            z-index: 10;
            transition: all 0.4s ease;
        }

        #countdown-timer {
            font-size: 2rem;
            color: var(--primary-red);
            font-weight: 700;
            text-shadow: 0 0 30px var(--glow-red);
        }
        
        .error-message {
            color: var(--primary-red-light) !important;
            font-weight: 600;
        }

        #dl-links {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            transition: opacity 0.3s ease, filter 0.3s ease;
        }

        #dl-links.disabled {
            pointer-events: none;
            opacity: 0.5;
            filter: grayscale(80%);
            cursor: not-allowed;
        }

        #dl-links.disabled .button {
            cursor: not-allowed;
        }

