        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 70%;
            padding: 12px 22px;
            font-family: 'Inter', Arial, sans-serif;
            font-size: 16px;
            font-weight: 500;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            border: 2px solid transparent;
            background-clip: padding-box;
            transition: all 0.2s ease-in-out;
            cursor: pointer;
            appearance: none;
        }

        .button img {
            height: 20px;
            width: 20px;
            margin-right: 10px;
        }

        .button:hover {
            transform: scale(1.05);
            border-color: #0099ff;
            box-shadow: 0 0 5px #0099ff, 0 0 10px #0099ff, 0 0 15px #0099ff;
        }

        #dl-links.disabled .button:hover {
            transform: none;
            border-color: transparent;
            box-shadow: none;
        }

        .direct-download {
            background-color: #800000;
            box-shadow: 0 0 8px #800000;
            border-color: #ffcccb;
        }

        .google-download {
            background-color: #800080;
            box-shadow: 0 0 8px #800080;
            border-color: #e5b1e5;
        }

        .telegram-download {
            background-color: #0088cc;
            box-shadow: 0 0 8px #0088cc;
            border-color: #b3e0f5;
        }

        .ios-warning-banner {
            display: none;
            background: #800000;
            border: 1px solid #a00000;
            border-radius: 12px;
            padding: 14px 18px;
            margin-bottom: 16px;
            color: #FFFFFF;
            font-size: 0.85rem;
            text-align: left;
            line-height: 1.7;
            box-shadow: 0 0 15px rgba(128, 0, 0, 0.4);
        }

        .multipart-banner {
            background: linear-gradient(135deg, #0088cc 0%, #005580 100%);
            border: 1px solid #00aaff;
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 16px;
            color: #fff;
            font-size: 0.9rem;
            text-align: center;
            box-shadow: 0 0 15px rgba(0, 136, 204, 0.3);
        }

        .custom-alert {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(8px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            padding: 20px;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .alert-content {
            background: var(--bg-card);
            border: 1px solid var(--border-red);
            padding: 32px;
            border-radius: 20px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5), 0 0 50px var(--glow-red);
            text-align: center;
            max-width: 450px;
            width: 100%;
            animation: scaleIn 0.3s ease;
        }

        @keyframes scaleIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .alert-content h2 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 16px;
            color: var(--text-white);
        }

        .alert-content p {
            font-size: 1rem;
            color: var(--text-gray);
            margin: 16px 0 24px;
            line-height: 1.7;
        }

        .text-red { color: var(--primary-red-light); }
        .text-green { color: #22C55E; }
        .text-white { color: var(--text-white); }

        .close-btn {
            background: var(--bg-card-hover);
            color: var(--text-white);
            border: 1px solid var(--border-dark);
            padding: 12px 28px;
            cursor: pointer;
            border-radius: 10px;
            font-size: 0.95rem;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            transition: all 0.25s ease;
            margin: 6px;
        }

        .close-btn:hover {
            background: var(--primary-red);
            border-color: var(--primary-red);
            box-shadow: 0 4px 15px var(--glow-red);
        }

        .additional-info {
            border-top: 1px solid var(--border-dark);
            margin-top: 32px;
            padding-top: 28px;
        }

        .additional-info h2 {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 16px;
            color: var(--text-white);
        }

        .additional-info p {
            font-size: 0.9rem;
            color: var(--text-gray);
            margin: 10px 0;
            line-height: 1.6;
        }

        .additional-info a {
            color: var(--primary-red-light);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.25s ease;
        }

        .additional-info a:hover {
            color: var(--text-white);
            text-shadow: 0 0 10px var(--glow-red);
        }

        #count li {
            color: var(--primary-red-light);
            text-align: left;
            margin: 8px 0;
        }

        #count p {
            font-size: 0.95rem;
            color: var(--text-gray);
        }

        #count a {
            color: var(--primary-red-light);
            text-decoration: none;
            transition: color 0.25s ease;
        }

        #count a:hover {
            color: var(--text-white);
        }

        #countdown-overlay a {
            color: var(--primary-red-light);
            text-decoration: none;
        }

        .spinner {
            width: 48px;
            height: 48px;
            border: 4px solid var(--border-dark);
            border-top-color: var(--primary-red);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 20px auto;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @media (max-width: 640px) {
            body {
                padding: 12px;
            }

            .container {
                border-radius: 16px;
            }

            .content-wrapper {
                padding: 24px 20px;
            }

            .download-section h4 {
                font-size: 0.9rem;
            }

            .file-info-card {
                padding: 14px 16px;
            }

            .file-info {
                font-size: 0.85rem;
                flex-direction: column;
                gap: 4px;
            }

            .file-info span {
                text-align: left;
            }

            .button {
                padding: 10px 18px;
                font-size: 15px;
                width: 90%;
            }

            .additional-info h2 {
                font-size: 1rem;
            }

            .additional-info p {
                font-size: 0.85rem;
            }

            .alert-content {
                padding: 24px 20px;
            }

            .alert-content h2 {
                font-size: 1.25rem;
            }

            .alert-content p {
                font-size: 0.9rem;
            }
        }

        @media (max-width: 400px) {
            .content-wrapper {
                padding: 20px 16px;
            }

            .button {
                padding: 12px 16px;
                font-size: 0.8rem;
            }
        }

        .noscript-warning {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 9999;
            background: linear-gradient(135deg, var(--primary-red-dark) 0%, var(--primary-red) 100%);
            border-bottom: 2px solid var(--primary-red-light);
            padding: 16px 20px;
            text-align: center;
            color: var(--text-white);
        }

        .noscript-warning p {
            margin: 6px 0;
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .noscript-warning strong {
            font-weight: 700;
        }

        @media (max-width: 640px) {
            .noscript-warning {
                padding: 12px 16px;
            }

            .noscript-warning p {
                font-size: 0.85rem;
            }
        }

        #loading-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #0A0A0A;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 99999;
            transition: opacity 0.5s ease, visibility 0.5s ease;
        }

        #loading-screen.hidden {
            opacity: 0;
            visibility: hidden;
        }

        .loader-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 30px;
        }

        .loader-logo {
            font-size: 2rem;
            font-weight: 700;
            color: #fff;
            text-shadow: 0 0 20px rgba(220, 38, 38, 0.5);
        }

        .loader-logo span {
            color: #DC2626;
        }

        .loader-bars {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .loader-bar {
            width: 6px;
            height: 40px;
            background: linear-gradient(180deg, #DC2626 0%, #991B1B 100%);
            border-radius: 3px;
            animation: loaderPulse 1s ease-in-out infinite;
        }

        .loader-bar:nth-child(1) { animation-delay: 0s; }
        .loader-bar:nth-child(2) { animation-delay: 0.1s; }
        .loader-bar:nth-child(3) { animation-delay: 0.2s; }
        .loader-bar:nth-child(4) { animation-delay: 0.3s; }
        .loader-bar:nth-child(5) { animation-delay: 0.4s; }

        @keyframes loaderPulse {
            0%, 100% {
                transform: scaleY(0.4);
                opacity: 0.5;
            }
            50% {
                transform: scaleY(1);
                opacity: 1;
            }
        }

        .loader-ring {
            width: 50px;
            height: 50px;
            border: 4px solid #1A1A1A;
            border-top: 4px solid #DC2626;
            border-right: 4px solid #fff;
            border-radius: 50%;
            animation: loaderSpin 1s linear infinite;
        }

        @keyframes loaderSpin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .loader-text {
            color: #A3A3A3;
            font-size: 0.9rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            animation: loaderFade 1.5s ease-in-out infinite;
        }

        @keyframes loaderFade {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1; }
        }
    </style>
</head>

